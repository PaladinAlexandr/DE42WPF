<UserControl x:Class="DE42WPF.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DE42WPF"
             mc:Ignorable="d" 
             Background="White"
             FontSize="19"
             FontFamily="Times New Roman"
            Height="200" Width="1000">
    <Border BorderBrush="Black" BorderThickness="5">
        <Grid >
            <Border BorderBrush="Black" BorderThickness="2" Margin="10,10,770,10">
                <Image  x:Name="PhotoProductImage" Source="/picture.png"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" Margin="225,10,115,10">
                <StackPanel>
                    <TextBlock x:Name="NameCategoryTextBlock"  TextWrapping="Wrap" Text="TextBlock" FontWeight="Bold"/>
                    <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="ManufactureTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="SupplierTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="PriceTextBlock" TextWrapping="Wrap" Text="TextBlock">
                        <Run x:Name="OldPrice"  Text=""></Run>
                        <Run x:Name="NewPrice" Text=""></Run>
                    </TextBlock>
                    <TextBlock x:Name="UnitMetricTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="AmountTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="2" Margin="880,10,10,10">
                <TextBlock x:Name="DiscountTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="TextBlock" Height="42" Width="80"/>
            </Border>
        </Grid>

    </Border>

</UserControl>
