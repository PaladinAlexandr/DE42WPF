<Window x:Class="DE42WPF.ListProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE42WPF"
        mc:Ignorable="d"
        Title="ListProductWindow" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="FullnameTextBlock" HorizontalAlignment="Right"  TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="24" Width="277"/>
        <ListBox x:Name="ProductListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,111,0,0"/>
        <TextBox x:Name="SearchTextBox" HorizontalAlignment="Left" Margin="18,34,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="343" TextChanged="TextBox_TextChanged"/>
        <ComboBox x:Name="SortComboBox" HorizontalAlignment="Left" Margin="376,32,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem Content="По возрастанию"/>
            <ComboBoxItem Content="По убыванию"/>
        </ComboBox>
        <TextBlock x:Name="SearchTextBLOCK" HorizontalAlignment="Left" Margin="18,13,0,0" TextWrapping="Wrap" Text="Поиск" VerticalAlignment="Top"/>
        <ComboBox x:Name="FilterComboBox" HorizontalAlignment="Left" Margin="376,66,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="FilterComboBox_SelectionChanged" >
            <ComboBoxItem Content="Все поставщики"/>
            <ComboBoxItem Content="Kari"/>
            <ComboBoxItem Content="Обувь для вас"/>
        </ComboBox>
        <Button Content="Добавить товар" HorizontalAlignment="Left" Margin="540,66,0,0" VerticalAlignment="Top" Width="122" Click="Button_Click"/>

    </Grid>
</Window>
