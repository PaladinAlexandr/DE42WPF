<Window x:Class="DE42WPF.ListProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE42WPF"
        mc:Ignorable="d"
        Title="ListProductWindow" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="FullnameTextBlock" HorizontalAlignment="Right"  TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="24" Width="277"/>
        <ListBox x:Name="ProductListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,46,0,0"/>

    </Grid>
</Window>
