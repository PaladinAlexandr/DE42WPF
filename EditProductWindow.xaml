<Window x:Class="DE42WPF.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE42WPF"
        mc:Ignorable="d"
        FontSize="10"
        Title="EditProductWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <Border BorderBrush="Black" BorderThickness="5" Margin="0,0,0,200">
            <Grid >
                <Border BorderBrush="Black" BorderThickness="2" Margin="10,10,621,10">
                    <Image  x:Name="PhotoProductImage" Source="/picture.png"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Margin="174,10,115,10">
                    <StackPanel>
                        <TextBox x:Name="NameTextBox"  TextWrapping="Wrap" Text="TextBox" FontWeight="Bold"/>
                        <ComboBox x:Name="CategoryTextBox" Text="TextBox" FontWeight="Bold">
                            <ComboBoxItem Content="Женская обувь"></ComboBoxItem>
                            <ComboBoxItem Content="Мужская обувь"></ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="ArticleTextBox"  TextWrapping="Wrap" Text="TextBox" FontWeight="Bold"/>
                        <TextBox x:Name="DescriptionTextBox" TextWrapping="Wrap" Text="TextBox"/>
                        <ComboBox x:Name="ManufactureTextBox" Text="TextBox">
                            <ComboBoxItem Content="Kari"></ComboBoxItem>
                            <ComboBoxItem Content="Marco Tozzi"></ComboBoxItem>
                            <ComboBoxItem Content="CROSBY"></ComboBoxItem>
                            <ComboBoxItem Content="Poc"></ComboBoxItem>
                            <ComboBoxItem Content="Rieker"></ComboBoxItem>
                            <ComboBoxItem Content="Alessio Nesca"></ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="SupplierTextBox" >
                            <ComboBoxItem Content="Kari"></ComboBoxItem>
                            <ComboBoxItem Content="Обувь для вас"></ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="PriceTextBox" TextWrapping="Wrap" Text="TextBox">

                        </TextBox>
                        <TextBox x:Name="UnitMetricTextBox" TextWrapping="Wrap" Text="TextBox"/>
                        <TextBox x:Name="AmountTextBox" TextWrapping="Wrap" Text="TextBox"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="2" Margin="688,10,0,10" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <TextBox x:Name="DiscountTextBox" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="TextBox" Height="42" Width="80"/>
                </Border>
            </Grid>

        </Border>
        <Button Content="Редактирование" HorizontalAlignment="Left" Height="50" Margin="52,283,0,0" VerticalAlignment="Top" Width="110" Click="Button_Click" />
        <Button Content="Назад" HorizontalAlignment="Left" Margin="652,297,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
    </Grid>
</Window>
