<UserControl x:Class="DE42WPF.OrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DE42WPF"
             mc:Ignorable="d" 
             Background="White"
             FontFamily="Times New Roman"
             FontSize="18"
             Height="150" Width="800">
            
    <Border BorderBrush="Black" BorderThickness="2">
        <Grid >
            <Border BorderBrush="Black" BorderThickness="2" Margin="630,10,10,10">
                <TextBlock x:Name="DateDeliveryTextBlock" TextWrapping="Wrap" Text="TextBlock" Margin="8,23,0,0"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" Margin="10,10,181,10">
                <StackPanel Margin="9,9,0,25">
                    <TextBlock x:Name="ArticleOrderTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="StatusOrderTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="AddressPickPointTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                    <TextBlock x:Name="DateOrderTextBlock" TextWrapping="Wrap" Text="TextBlock"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
