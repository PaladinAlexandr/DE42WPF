<Window x:Class="DE42WPF.ListOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE42WPF"
        mc:Ignorable="d"
        Title="ListOrderWindow" Height="450" Width="800">
    <Grid Margin="0,120,0,0">
        <ListBox x:Name="OrderListBox" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="OrderListBox_MouseDoubleClick"/>
        <Button x:Name="AddOrderButton" Content="Добавить заказ" HorizontalAlignment="Left" Margin="33,-39,0,0" VerticalAlignment="Top" Click="AddOrderButton_Click"/>
        <Button x:Name="DeleteOrderButton" Content="Удалить заказ" HorizontalAlignment="Left" Margin="33,-73,0,0" VerticalAlignment="Top" Width="89" Click="DeleteOrderButton_Click"/>
        <Button x:Name="BackButton" Content="Назад" HorizontalAlignment="Left" Margin="703,-78,0,0" VerticalAlignment="Top" Width="82" Click="BackButton_Click"/>

    </Grid>
</Window>
